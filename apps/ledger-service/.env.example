# Local Docker/development credentials only. Replace database, JWT, service and
# broker credentials through secret management outside local Compose.
PORT=3001
DATABASE_HOST=ledger-db
DATABASE_PORT=5432
DATABASE_USER=ledger
DATABASE_PASSWORD=ledger
DATABASE_NAME=ledger
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PAYMENTS_SERVICE_TOKEN=change-me-payments-service
RABBITMQ_URL=amqp://p2p:p2p@rabbitmq:5672
RABBITMQ_EXCHANGE=p2p.domain-events
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
CORS_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
OTEL_SERVICE_NAME=ledger-service
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
